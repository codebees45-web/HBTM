# Frontend (Vite) config. Copy this file to .env in this same folder
# (the project root, not server/) — Vite only loads VITE_-prefixed vars
# from here, never from server/.env.

# Same OAuth client ID as server/.env's GOOGLE_CLIENT_ID.
# Get one at https://console.cloud.google.com/apis/credentials
# (Create Credentials -> OAuth client ID -> Web application), and add
# your dev URL (e.g. http://localhost:5173) under "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional — only needed if your API isn't on the Vite dev proxy default.
# VITE_AUTH_URL=/api/auth
# VITE_STATE_URL=/api/state